{
  "name": "lampstand-api",
  "version": "0.0.1",
  "description": "API for the Lampstand project",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "nodemon src/index.ts",
    "test": "jest",
    "lint": "eslint --max-warnings 0 . && tsc --noEmit",
    "lint-fix": "eslint --fix .",
    "docker:run-build": "docker-compose up --build",
    "docker:build": "docker-compose build",
    "docker:run": "docker-compose up",
    "docker:stop": "docker-compose down",
    "prepare": "husky install",
    "cleanup": "rm -rf node_modules yarn.lock",
    "typeorm": "yarn run build && POSTGRES_HOST=localhost SYNC_DATABASE=false npx typeorm -d dist/database/data-source.js",
    "migration:generate": "yarn run typeorm migration:generate src/migrations/new-migration",
    "migration:run": "yarn run typeorm migration:run",
    "migration:revert": "yarn run typeorm migration:revert"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.1.3",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "form-data": "^4.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mailgun.js": "^10.2.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "supertest": "^6.3.3",
    "typedi": "^0.10.0",
    "typeorm": "0.3.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.13",
    "@types/dockerode": "^3.3.29",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.7",
    "@types/mailgun-js": "^0.22.18",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "dockerode": "^4.0.2",
    "dockerode-utils": "^0.0.7",
    "eslint": "^8.42.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "eslint-plugin-unicorn": "^53.0.0",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "nodemon": "^3.1.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm-extension": "^2.8.1",
    "typescript": "4.9.5",
    "winston": "^3.13.0"
  }
}
